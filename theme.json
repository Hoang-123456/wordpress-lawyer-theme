{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "palette": [
        { "name": "Primary (Petrol)", "slug": "primary",       "color": "#0d2b2e" },
        { "name": "Accent (Saffron)", "slug": "accent",        "color": "#e6a817" },
        { "name": "Text",             "slug": "text",          "color": "#1a1a1a" },
        { "name": "Muted",            "slug": "muted",         "color": "#57524c" },
        { "name": "White",            "slug": "white",         "color": "#ffffff" },
        { "name": "Surface",          "slug": "surface",       "color": "#f0f7f7" },
        { "name": "Border",           "slug": "border",        "color": "#dde8e8" },
        { "name": "Service Green",    "slug": "service-green", "color": "#2e7d5e" },
        { "name": "Service Amber",    "slug": "service-amber", "color": "#b5841a" },
        { "name": "Service Teal",     "slug": "service-teal",  "color": "#1e6b7a" },
        { "name": "Service Gray",     "slug": "service-gray",  "color": "#4a4540" },
        { "name": "Error",            "slug": "error",         "color": "#b3261e" }
      ],
      "custom":           false,
      "defaultPalette":   false,
      "defaultGradients": false,
      "duotone":          [],
      "defaultDuotone":   false
    },
    "typography": {
      "fontFamilies": [
        {
          "name":       "Inter",
          "slug":       "inter",
          "fontFamily": "Inter, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily":  "Inter",
              "fontWeight":  "400",
              "fontStyle":   "normal",
              "fontDisplay": "swap",
              "src":         ["file:./assets/fonts/inter-400.woff2"]
            },
            {
              "fontFamily":  "Inter",
              "fontWeight":  "500",
              "fontStyle":   "normal",
              "fontDisplay": "swap",
              "src":         ["file:./assets/fonts/inter-500.woff2"]
            },
            {
              "fontFamily":  "Inter",
              "fontWeight":  "600",
              "fontStyle":   "normal",
              "fontDisplay": "swap",
              "src":         ["file:./assets/fonts/inter-600.woff2"]
            }
          ]
        },
        {
          "name":       "Playfair Display",
          "slug":       "playfair",
          "fontFamily": "'Playfair Display', Georgia, serif",
          "fontFace": [
            {
              "fontFamily":  "Playfair Display",
              "fontWeight":  "700",
              "fontStyle":   "normal",
              "fontDisplay": "swap",
              "src":         ["file:./assets/fonts/playfair-display-700.woff2"]
            }
          ]
        }
      ],
      "fontSizes": [
        { "name": "Small",  "slug": "sm",   "size": "0.875rem" },
        { "name": "Base",   "slug": "base", "size": "1rem" },
        { "name": "Medium", "slug": "md",   "size": "1.125rem" },
        { "name": "Large",  "slug": "lg",   "size": "1.5rem" },
        { "name": "XL",     "slug": "xl",   "size": "2rem" },
        { "name": "Hero",   "slug": "hero", "size": "clamp(2rem, 4.5vw, 3rem)" }
      ],
      "customFontSize": false,
      "dropCap":        false,
      "fluid":          true
    },
    "spacing": {
      "spacingSizes": [
        { "name": "XS", "slug": "xs", "size": "0.5rem" },
        { "name": "S",  "slug": "s",  "size": "1rem" },
        { "name": "M",  "slug": "m",  "size": "2rem" },
        { "name": "L",  "slug": "l",  "size": "4rem" },
        { "name": "XL", "slug": "xl", "size": "6rem" }
      ],
      "customSpacingSize": false,
      "units": ["px", "rem", "%"]
    },
    "layout": {
      "contentSize": "740px",
      "wideSize":    "1100px"
    },
    "border": {
      "color":  true,
      "radius": true,
      "style":  true,
      "width":  true
    },
    "shadow": {
      "presets": [
        { "name": "Subtle", "slug": "subtle", "shadow": "0 2px 8px rgba(0,0,0,0.06)" },
        { "name": "Medium", "slug": "medium", "shadow": "0 4px 16px rgba(0,0,0,0.1)" }
      ]
    },
    "blocks": {
      "core/button": {
        "border": { "radius": true }
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--white)",
      "text":       "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize":   "var(--wp--preset--font-size--base)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--m)"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontSize":   "var(--wp--preset--font-size--hero)",
          "fontWeight": "700",
          "lineHeight": "1.15"
        }
      },
      "h2": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontSize":   "var(--wp--preset--font-size--xl)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        }
      },
      "h3": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--playfair)",
          "fontSize":   "var(--wp--preset--font-size--lg)",
          "fontWeight": "700",
          "lineHeight": "1.3"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize":   "var(--wp--preset--font-size--md)",
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "underline"
        },
        ":hover": {
          "color": {
            "text": "var(--wp--preset--color--text)"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--accent)",
          "text":       "var(--wp--preset--color--primary)"
        },
        "typography": {
          "fontWeight":     "600",
          "fontSize":       "var(--wp--preset--font-size--sm)",
          "letterSpacing":  "0.08em",
          "textTransform":  "uppercase",
          "textDecoration": "none"
        },
        "border": {
          "radius": "3px"
        },
        "spacing": {
          "padding": {
            "top":    "0.875rem",
            "bottom": "0.875rem",
            "left":   "2rem",
            "right":  "2rem"
          }
        },
        ":hover": {
          "color": {
            "background": "var(--wp--preset--color--primary)"
          }
        }
      }
    }
  }
}
